# ---- Expo / React Native ----
node_modules/
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.log

# prebuild 生成的原生工程（CI / 本地构建时重新生成）——必须根锚定：
# 未锚定的 android/ 会连 modules/<本地模块>/android/ 一并吞掉（本地 Expo 模块的
# 原生源码是要入库的，与生成物本质不同）；模块自身的 Gradle 产物仍要忽略
/android/
/ios/
modules/*/android/build/
modules/*/android/.gradle/

# 签名与密钥文件
*.jks
*.keystore
*.p8
*.p12
*.key
# keystore 的 base64 文本形式（certutil -encode 产物，等同 keystore 本体的敏感度）
keystore-b64.txt
*-b64.txt
.env
.env.*

# ---- 本地工具 ----
.zcode/
.vscode/
.idea/
.DS_Store

# ---- 个人真实训练数据（仅本地测试素材，严禁入库/外发）----
# 2026-10-11 起放 docs-private/sample-fit-files/（整目录已被 docs-private/ 规则忽略，
# 此行显式保留：防 docs-private/ 忽略规则被误删时个人健康数据裸露）
docs-private/sample-fit-files/
# PoC 4 用训练库由样例 FIT 派生（含个人训练数据），仅本地存在
assets/poc/*.db
assets/poc-output/
# 黄金 diff 基准由真实训练派生（npm run golden），仅本地存在
golden/

# ---- 内部工作文档与旧版快照（本地保留、不入库，开源面不含）----
AGENTS.md
.zcodeignore
reference/
docs-private/

# ---- 测试 / 覆盖率 ----
coverage/

# ---- 本地分发产物（APK，不入库）----
build-output/
